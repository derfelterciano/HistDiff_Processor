{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "histdiff-pipeline",
	"version": "0.1.0",
	"identifier": "com.histdiff-pipeline.app",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "histdiff-pipeline",
				"width": 2560,
				"height": 1440
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/128x128.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
