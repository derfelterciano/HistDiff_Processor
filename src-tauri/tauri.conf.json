{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "histdiff-pipeline",
  "version": "0.5.3",
  "identifier": "com.histdiff-pipeline.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "histdiff-pipeline",
        "width": 500,
        "height": 700,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0ODdEREM1MDVFODhBQjYKUldTMml1Z0Z4ZDJIMUo4cUgzRkhEelFXaTdOTVNhRHFrL1VydytVY3ZldVlGZUN4Mi9obWc3UVIK",
      "endpoints": [
        "https://github.com/derfelterciano/HistDiff_Processor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
